# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

# Wrangler's local cache/state (account id cache, dev-session state). Not a
# secret by itself, but machine-local and not meant to be committed.
cloudflare/.wrangler/
.wrangler/